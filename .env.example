# Токен бота от @BotFather
TG_BOT_TOKEN=

# ID каналов (числа вида -1001234567890) и твой личный chat id
TG_CHANNEL_A=
TG_CHANNEL_B=
TG_CHANNEL_C=
TG_OWNER_ID=

# База: Neon Postgres в проде. Пусто = локальный SQLite в data/news.db
DATABASE_URL=

# LLM: anthropic (по умолчанию) или groq. Без ключа конвейер работает без модели.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# 1 = ничего не отправлять в телеграм, только печатать в лог
DRY_RUN=0
